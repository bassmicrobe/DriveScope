<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="DriveScope — ドライブ容量の見える化" Width="1320" Height="900" MinWidth="1080" MinHeight="740" WindowStartupLocation="CenterScreen" Background="#10141D" Foreground="#E9EDF5" FontFamily="Yu Gothic UI, Segoe UI" FontSize="13">
  <Window.Resources>
    <SolidColorBrush x:Key="Panel" Color="#191F2C"/>
    <SolidColorBrush x:Key="Muted" Color="#A3AEC2"/>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#E9EDF5"/><Setter Property="Background" Value="#293246"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="16,10"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Body" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Body" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#101620"/><Setter Property="Foreground" Value="#E9EDF5"/><Setter Property="CaretBrush" Value="White"/><Setter Property="BorderBrush" Value="#354059"/><Setter Property="Padding" Value="10,8"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="#191F2C"/><Setter Property="Foreground" Value="#E9EDF5"/><Setter Property="BorderThickness" Value="0"/><Setter Property="RowBackground" Value="#191F2C"/><Setter Property="AlternatingRowBackground" Value="#1C2331"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="RowHeight" Value="39"/><Setter Property="EnableRowVirtualization" Value="True"/>
      <Setter Property="ColumnHeaderStyle"><Setter.Value><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#151B26"/><Setter Property="Foreground" Value="#A3AEC2"/><Setter Property="Padding" Value="12,11"/><Setter Property="BorderThickness" Value="0"/></Style></Setter.Value></Setter>
      <Setter Property="CellStyle"><Setter.Value><Style TargetType="DataGridCell"><Setter Property="Padding" Value="12,0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#30415B"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers></Style></Setter.Value></Setter>
    </Style>
    <Style TargetType="TabItem"><Setter Property="Foreground" Value="#A3AEC2"/><Setter Property="Background" Value="#191F2C"/><Setter Property="Padding" Value="18,12"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabBody" Background="{TemplateBinding Background}" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#8DE1C9"/><Setter TargetName="TabBody" Property="BorderBrush" Value="#8DE1C9"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Foreground" Value="#E9EDF5"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="CategoryBody" CornerRadius="7" Background="Transparent" Padding="12,3"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="CategoryBody" Property="Background" Value="#303A51"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CategoryBody" Property="BorderBrush" Value="#46536D"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  </Window.Resources>
  <Grid Margin="28,22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="DriveScope" FontSize="29" FontWeight="SemiBold"/><Border Background="#263C3B" CornerRadius="5" Margin="12,8,0,6" Padding="8,2"><TextBlock Text="LOCAL" Foreground="#8DE1C9" FontSize="10" FontWeight="Bold"/></Border></StackPanel><TextBlock Text="接続中のドライブから、調べたい対象にチェック。" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="RefreshDrives" Content="ドライブ更新" Margin="0,0,8,0"/><Button x:Name="Export" Content="CSV出力" Margin="0,0,8,0"/><Button x:Name="Stop" Content="中断" Margin="0,0,8,0"/><Button x:Name="Scan" Content="チェックしたドライブをスキャン" Background="#8DE1C9" Foreground="#102A26" FontWeight="SemiBold"/></StackPanel>
    </Grid>
    <Grid Grid.Row="1" Margin="-5,0,-5,16"><TextBlock x:Name="NoDrives" Text="接続されたドライブがありません。「ドライブ更新」で再確認できます。" Foreground="{StaticResource Muted}" Margin="14,20" Visibility="Collapsed"/><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel x:Name="DriveCards" Orientation="Horizontal"/></ScrollViewer></Grid>
    <Border Grid.Row="2" Background="#191F2C" CornerRadius="10" Padding="16,11" Margin="0,0,0,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="Overview" Content="対象ドライブの比較" Padding="12,7" Background="#303C52"/><TextBlock x:Name="ScanStatus" Grid.Column="1" VerticalAlignment="Center" Margin="14,0" Foreground="{StaticResource Muted}" Text="スキャンを開始すると、実際のファイルから分類します。" TextTrimming="CharacterEllipsis"/><Button x:Name="ScanSelected" Grid.Column="2" Content="表示ドライブをスキャン" Padding="12,7"/></Grid></Border>
    <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="290"/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Background="#191F2C" CornerRadius="12" Padding="12"><DockPanel><StackPanel DockPanel.Dock="Top" Margin="10,8,10,12"><TextBlock Text="カテゴリ別の使用量" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="CategorySubtitle" Text="全ドライブ · ファイルサイズ合計" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0"/></StackPanel><ListBox x:Name="Categories" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/></DockPanel></Border>
      <Border Grid.Column="2" Background="#191F2C" CornerRadius="12" Padding="18,16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="DetailTitle" Text="すべてのカテゴリ" FontSize="21" FontWeight="SemiBold"/><TextBlock x:Name="DetailSummary" Text="スキャン結果はこのPCに保存されます。" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel><TextBlock x:Name="DetailSize" Grid.Column="1" FontSize="30" FontWeight="SemiBold" Foreground="#8DE1C9" VerticalAlignment="Center" Text="—"/></Grid>
        <Grid x:Name="SearchControls" Grid.Row="1" Margin="0,18,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions><Button x:Name="Up" Content="↑ 上へ" Padding="10,7"/><TextBlock x:Name="FolderPath" Grid.Column="1" Text="全ドライブのルート" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Muted}" Margin="12,0" VerticalAlignment="Center"/><TextBox x:Name="Search" Grid.Column="2" ToolTip="表示中の一覧を名前・パスで絞り込み"/></Grid>
        <TextBlock x:Name="SearchHint" Grid.Row="2" Text="検索欄で表示中の一覧を絞り込み · フォルダをダブルクリックで掘り下げ" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,9"/>
        <TabControl x:Name="Tabs" Grid.Row="3" SelectedIndex="3" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,12,0,0">
          <TabItem Header="フォルダ"><DataGrid x:Name="Folders"><DataGrid.Columns><DataGridTextColumn Header="フォルダ名" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="サイズ" Binding="{Binding Size}" SortMemberPath="Bytes" Width="110"/><DataGridTextColumn Header="割合" Binding="{Binding Share}" SortMemberPath="Ratio" Width="75"/></DataGrid.Columns></DataGrid></TabItem>
          <TabItem Header="大きいファイル"><DataGrid x:Name="Files"><DataGrid.Columns><DataGridTextColumn Header="ファイル名" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="カテゴリ" Binding="{Binding Category}" Width="140"/><DataGridTextColumn Header="サイズ" Binding="{Binding Size}" SortMemberPath="Bytes" Width="110"/></DataGrid.Columns></DataGrid></TabItem>
          <TabItem Header="除外・読取エラー"><DataGrid x:Name="Issues"><DataGrid.Columns><DataGridTextColumn Header="パス・理由（最大1,000件／ドライブ）" Binding="{Binding Name}" Width="*"/></DataGrid.Columns></DataGrid></TabItem>
          <TabItem Header="ドライブ比較"><DataGrid x:Name="Comparison" RowHeight="22" ColumnHeaderHeight="30" FontSize="12" ScrollViewer.HorizontalScrollBarVisibility="Auto"><DataGrid.ColumnHeaderStyle><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#151B26"/><Setter Property="Foreground" Value="#A3AEC2"/><Setter Property="Padding" Value="12,5"/><Setter Property="BorderThickness" Value="0"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style></DataGrid.ColumnHeaderStyle></DataGrid></TabItem>
        </TabControl>
        <Grid x:Name="DetailFooter" Grid.Row="4" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="ListNote" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Text=""/><Button x:Name="Reveal" Grid.Column="1" Content="エクスプローラーで表示" Padding="12,7"/></Grid>
      </Grid></Border>
    </Grid>
    <TextBlock Grid.Row="4" Margin="2,13,0,0" Text="ファイルサイズによる概算分類です。圧縮・ハードリンク・管理領域などでディスクの実使用量と差が出ます。再解析ポイントは除外します。" Foreground="#8996AB" FontSize="11" TextWrapping="Wrap"/>
  </Grid>
</Window>
